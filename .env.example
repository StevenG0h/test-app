# Waiting room session test app — configuration.
# Copy this file to .env and fill in your real values, then restart the dev server.

# POST endpoint used to request a waiting-room token. Called with credentials
# (cookies) on every page load and every route change.
#   - 200 {token, session} => pass-through (active)
#   - 200 {token}          => existing session (active)
#   - 200 {message}        => joined the queue -> in-app waiting room
#   - other / network error => retry screen (no redirect)
VITE_REQUEST_TOKEN_URL=http://localhost:8787/api/token/request

# GET endpoint used to validate a token. Called with ?token=... plus cookies
# when the app re-checks an existing token on a route change.
#   - 2xx  => token valid
#   - 400  => token missing/invalid/expired -> in-app waiting room
#   - other / network error => retry screen
VITE_VALIDATE_TOKEN_URL=http://localhost:8787/api/token/validate

# GET endpoint used to invalidate a token. Called with ?token=...&userId=...
# when the user clicks "Revoke session" on the /expire page.
#   - 2xx  => token invalidated
#   - 400  => token invalid/expired (error shown with a retry button)
VITE_INVALIDATE_TOKEN_URL=http://localhost:8787/api/token/invalidate

# URL users are sent to when they are in the waiting room.
# Used exactly as configured (no query params are appended).
VITE_WAITING_ROOM_URL=http://localhost:8787/waiting-room

# Name of the session cookie. Informational/logging only — the app treats the
# token endpoints as the source of truth, so HttpOnly cookies work fine.
VITE_SESSION_COOKIE_NAME=session
