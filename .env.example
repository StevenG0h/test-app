# Waiting room session test app — configuration.
# Copy this file to .env and fill in your real values, then restart the dev server.

# GET endpoint used to validate the session. Called with credentials (cookies)
# sent automatically on every page load and every route change.
#   - 2xx       => session active
#   - 401/403   => session missing/expired -> redirect to VITE_WAITING_ROOM_URL
#   - other / network error => retry screen (no redirect)
VITE_VALIDATE_URL=http://localhost:8787/api/session/validate

# POST endpoint used to revoke/expire the session. Called with credentials
# when the user clicks "Revoke session" on the /expire page.
#   - 2xx       => revoke succeeded
#   - other / network error => error shown with a retry button
VITE_REVOKE_URL=http://localhost:8787/api/session/revoke

# URL users are sent to when the session is missing or invalid.
# Used exactly as configured (no query params are appended).
VITE_WAITING_ROOM_URL=http://localhost:8787/waiting-room

# Name of the session cookie. Informational/logging only — the app treats the
# validation endpoint as the source of truth, so HttpOnly cookies work fine.
VITE_SESSION_COOKIE_NAME=session
